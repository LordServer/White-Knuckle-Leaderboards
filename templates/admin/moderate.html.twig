{% extends 'base.html.twig' %}

{% block title %}{{ climber.DisplayName|escape }} Moderation{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <h1 class="text-4xl font-bold mt-1">Moderate {{ climber.displayName|escape }}</h1>
        <div data-controller="user-status">
            {{ form_start(form) }}
            <div class="flex gap-2">
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">
                        {{ form_label(form.status) }}
                    </div>
                    {{ form_widget(form.status, {attr: {'data-user-status-target': 'status', 'data-action': 'change->user-status#toggle', 'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
                <div data-user-status-target="banDays" class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">
                        Days
                    </div>
                    {{ form_widget(form.banDays, {'attr': {'class': 'text-right w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
            </div>
            <div class="text-right pt-2">
                <button type="submit" class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">
                    Save
                </button>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
