<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %} | White Knuckle</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
        <link rel="icon" href="{{ asset('build/images/favicon.ico') }}" type="image/x-icon">
    </head>
    <body style="background-image: url({{ asset('build/images/background-01.jpg') }})" class="bg-cover bg-center bg-no-repeat bg-fixed text-white" data-controller="timezone">
        <div class="bg-black fixed h-16 w-full opacity-75 backdrop-blur-xs top-0 left-0 z-50">
            {% include 'partials/navbar.html.twig' %}
        </div>
        <div class="mt-17 lg:w-4xl xl:w-7xl m-auto">
            <div class="flex flex-row flex-wrap w-full gap-4">
                <main class="z-3 rounded-lg h-fit bg-black p-1 inset-shadow-gray-900 inset-shadow-sm drop-shadow-[4px_8px_2px_rgba(80,14,15,1.00)] flex lg:flex-col lg:flex-2 w-full">
                    {% block body %}{% endblock %}
                </main>
                <div class="flex flex-col flex-1 gap-4">
                    {% include 'partials/climb_stats.html.twig' %}
                    {% include 'partials/recent_climbs.html.twig' %}
                </div>
            </div>
        </div>
        <footer></footer>
        <div>
            <img
                class="block left-0 w-[19.5%] mb-[-8.4%] bottom-0 select-none fixed animate-[wiggle_5s_ease-in-out_infinite]"
                draggable="false"
                src="{{ asset('build/images/open_hand.png') }}"
                alt="White Knuckle Hand Left"
                onmousedown="this.src='{{ asset('build/images/closed_hand.png') }}'"
                onmouseup="this.src='{{ asset('build/images/open_hand.png') }}'"
                onmouseleave="this.src='{{ asset('build/images/open_hand.png') }}'"
            >
            <img
                class="block right-0 -scale-x-100 w-[19.5%] mb-[-8.4%] bottom-0 select-none fixed animate-[wiggle_5s_ease-in-out_infinite]"
                draggable="false"
                src="{{ asset('build/images/open_hand.png') }}"
                alt="White Knuckle Hand Right"
                onmousedown="this.src='{{ asset('build/images/closed_hand.png') }}'"
                onmouseup="this.src='{{ asset('build/images/open_hand.png') }}'"
                onmouseleave="this.src='{{ asset('build/images/open_hand.png') }}'"
            >
        </div>
    </body>
</html>
