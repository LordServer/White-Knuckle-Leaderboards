{% extends 'base.html.twig' %}

{% block title %}Climbers{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <h1 class="text-4xl font-bold mt-1">My API Tokens</h1>
        <div>
            <table class="w-full border-collapse">
                <thead>
                    <tr>
                        <th class="text-left">Token</th>
                        <th class="text-left">Expires</th>
                        <th class="text-left">Enabled</th>
                        <th class="text-left">Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for apiToken in apiTokens %}
                        <tr class="hover:bg-gray-600">
                            <td>{{ apiToken.token|u.truncate(32, '********************')|escape }}</td>
                            <td>
                                {% if apiToken.expiresAt is null %}
                                    Never
                                {% else %}
                                    {{ apiToken.expiresAt|date('Y-m-d H:i:s')|escape }}
                                {% endif %}
                            </td>
                            <td>
                                {% if apiToken.isEnabled %}
                                    <i class="text-green-600 mdi mdi-check-bold"></i>
                                {% else %}
                                    <i class="text-red-900 mdi mdi-close-thick"></i>
                                {% endif %}
                            </td>
                            <td>
                                {% if apiToken.description is null %}
                                    —
                                {% else %}
                                    {{ apiToken.description|escape }}
                                {% endif %}
                            </td>
                            <td class="text-right">
                                <!-- TODO: Add buttons like in categories index -->
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="flex justify-between items-center border-t border-gray-700">
                <!-- TODO: setup pagination -->
                <span>Showing 1-2 of 2</span>
                <span>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400"><</button>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">1</button>
                    <span class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">...</span>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">3</button>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">4</button>
                    <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">5</button>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">6</button>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">7</button>
                    <span class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">...</span>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">10</button>
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">></button>
                </span>
                <span>
                    <el-dropdown>
                        <button>
                            <span class="bg-black rounded-sm border border-gray-600 border-solid text-white p-2 cursor-pointer hover:bg-red-400">
                                Per Page
                                <i class="mdi mdi-chevron-down"></i>
                            </span>
                        </button>
                        <el-menu anchor="bottom end" popover class="w-28 origin-top-right rounded-md bg-black text-white py-1 outline -outline-offset-1 outline-red-900 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
                            <a href="#" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">25</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">50</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">100</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">250</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">500</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">1000</a>
                        </el-menu>
                    </el-dropdown>
                </span>
            </div>
        </div>
    </div>
{% endblock %}
