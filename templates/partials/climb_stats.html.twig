<div class="rounded-lg h-fit bg-black p-1 inset-shadow-gray-900 inset-shadow-sm drop-shadow-[4px_8px_2px_rgba(80,14,15,1.00)] z-20">
    <div class="pt-2 pr-4 pb-2 pl-4">
        <h3 class="uppercase text-xl font-bold">All Climb Stats</h3>
        <div class="flex flex-row flex-wrap w-full">
            <div class="group relative inline-block flex-1">
                <div>Climbs</div>
fixed number formatting                <div>{{ climb_stats().totalClimbs|number_format }}</div>
                <div class="hidden group-hover:block absolute z-20 w-fit p-2 mt-2 text-sm bg-gray-900 text-white rounded-lg">
                    Total Climb Time: {{ climb_stats().totalTime|seconds_to_time }}<br>
                    Total Climb Height: {{ climb_stats().totalHeight|number_format(2) }} m<br>
                    Total / Recent Climbs: {{ climb_stats().totalClimbs|number_format }} / {{ climb_stats().recentClimbs|number_format }}
                </div>
            </div>
            <div class="group relative inline-block flex-1">
                <div>Climbers</div>
                <div>{{ total_users()|number_format|escape }}</div>
                <div class="hidden group-hover:block absolute z-20 w-fit p-2 mt-2 text-sm bg-gray-900 text-white rounded-lg">
                    Climbers (Total / Active): {{ total_users()|number_format|escape }} / {{ active_users()|number_format|escape }}
                </div>
            </div>
        </div>
    </div>
</div>
