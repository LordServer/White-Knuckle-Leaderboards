{% extends 'base.html.twig' %}

{% block title %}Hello ClimbController!{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <h1 class="text-2xl font-bold mt-1">
            {{ pageName|raw }}
        </h1>
        <div>
            {{ form_start(form) }}
            <div class="flex gap-2">
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.category) }}</div>
                    {{ form_widget(form.category, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.subcategory) }}</div>
                    {{ form_widget(form.subcategory, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
            </div>
            <div class="flex gap-2">
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.time) }}</div>
                    {{ form_widget(form.time, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.height) }}</div>
                    {{ form_widget(form.height, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
            </div>
            <div class="flex gap-2">
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.speed) }}</div>
                    {{ form_widget(form.speed, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.score) }}</div>
                    {{ form_widget(form.score, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
            </div>
            <div>
                <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.media_url) }}</div>
                {{ form_widget(form.media_url, {'attr': {'class': 'w-full h-13 py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
            </div>
            <div>
                <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.notes) }}</div>
                {{ form_widget(form.notes, {'attr': {'class': 'w-full h-52 py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
            </div>
            <div class="text-right pt-2">
                <a href="{{ path('climb_read', { 'climbId': climb.id }) }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Cancel</button>
                </a>
                {% if is_granted('ROLE_DISCORD_AUTHORIZER') %}
                    {{ form_widget(form.reject, {'attr': {'class': 'bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600'}}) }}
                    {{ form_widget(form.approve, {'attr': {'class': 'bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600'}}) }}
                {% endif %}
                <button type="submit" class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Update</button>
                <a href="{{ path('climb_delete', { 'climbId': climb.id }) }}">
                    <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
                </a>
            </div>
            <div class="hidden">
                {{ form_rest(form) }}
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
