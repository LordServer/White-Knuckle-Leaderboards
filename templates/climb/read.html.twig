{% extends 'base.html.twig' %}

{% block title %}Hello ClimbController!{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        <div class="text-xs text-red-900">
            <a href="{{ path('app_index') }}" class="hover:text-red-400 cursor-pointer">Home</a> /
            <a href="{{ path('climb_index') }}" class="hover:text-red-400 cursor-pointer">Climbs</a> /
            <a href="{{ path('climb_read', { 'climbId': climb.id }) }}" class="hover:text-red-400 cursor-pointer">{% if climb.subcategory.name != 'Normal' %}{{ climb.subcategory.name|escape }} {% endif %}{{ climb.category.name|escape }} with a {{ climb.category.rankMethod.name|lower }} of {% if climb.category.rankMethod.name == 'Score' %}{{ climb.score|number_format()|escape }}{% elseif climb.category.rankMethod.name == 'Time' %}{{ climb.time|seconds_to_time|escape }}{% elseif climb.category.rankMethod.name == 'Height' %}{{ climb.height|number_format(2)|escape }}{% elseif climb.category.rankMethod.name == 'Speed' %}{{ climb.speed|number_format(2)|escape }}{% endif %} by {{ climb.climber.displayName|escape }}</a>
        </div>
        <h1 class="text-2xl font-bold mt-1">
            {% if climb.subcategory.name != 'Normal' %}
                {{ climb.subcategory.name|escape }}
            {% endif %}
            {{ climb.category.name|escape }}
            <span class="font-normal text-gray-700 text-sm">with a {{ climb.category.rankMethod.name|lower }} of</span>
            {% if climb.category.rankMethod.name == 'Score' %}
                {{ climb.score|number_format()|escape }}
            {% elseif climb.category.rankMethod.name == 'Time' %}
                {{ climb.time|seconds_to_time|escape }}
            {% elseif climb.category.rankMethod.name == 'Height' %}
                {{ climb.height|number_format(2)|escape }} m
            {% elseif climb.category.rankMethod.name == 'Speed' %}
                {{ climb.speed|number_format(2)|escape }} m/s
            {% endif %}
            <span class="font-normal text-gray-700 text-sm">by</span>
            {{ climb.climber.displayName|escape }}
        </h1>
        <div>
            {{ climb.mediaUrl }}
        </div>
        <div class="flex gap-2">
            <div class="flex-1 flex flex-col">
                <div class="text-sm text-gray-700 pl-1">Leaderboard</div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Category</div>
                    <div>{{ climb.category.name|escape }}</div>
                </div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Subcategory</div>
                    <div>{{ climb.subcategory.name|escape }}</div>
                </div>
            </div>
            <div class="flex-1 flex flex-col">
                <div class="text-sm text-gray-700 pl-1">Details</div>
                {% if climb.isReviewed is true and climb.status.value === 'approved' %}
                    <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                        <div class="font-bold">Rank</div>
                        <div>{% if climb.rank === null %}Obsolete{% else %}{{ climb.rank|ordinalize|escape }}{% endif %}</div>
                    </div>
                {% endif %}
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Score</div>
                    <div>{{ climb.score|number_format()|escape }}</div>
                </div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Time</div>
                    <div>{{ climb.time|seconds_to_time|escape }}</div>
                </div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Height</div>
                    <div>{{ climb.height|number_format(2)|escape }} m</div>
                </div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Speed</div>
                    <div>{{ climb.speed|number_format(2)|escape }} m/s</div>
                </div>
            </div>
            <div class="flex-1 flex flex-col">
                <div class="text-sm text-gray-700 pl-1">Verification</div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Climber</div>
                    <div>{{ climb.climber.displayName|escape }}</div>
                </div>
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Status</div>
                    <div>{% if climb.isReviewed == 'true' %}{{ climb.status.value|capitalize }}{% else %}Pending Review{% endif %}</div>
                </div>
                {% if climb.isReviewed == 'true' %}
                    <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                        <div class="font-bold">Reviewer</div>
                        <div>{% if climb.verifier is not null %}{{ climb.verifier.username|escape }}{% else %}N/A{% endif %}</div>
                    </div>
                {% endif %}
                <div class="bg-gray-700 mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                    <div class="font-bold">Date</div>
                    <div class="group relative inline-block">
                        <div>{{ climb.createdAt|date('Y-m-d H:i:s')|ago }}</div>
                        <div class="hidden group-hover:block absolute z-10 w-fit p-2 mt-2 text-sm bg-gray-900 text-white rounded-lg">{{ climb.createdAt|date('Y-m-d H:i:s') }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="text-sm text-gray-700 pl-1">Notes</div>
            <div class="border-gray-700 border mt-1 mr-0 mb-1 ml-0 p-1 rounded-sm">
                {{ climb.notes|markdown_to_html }}
            </div>
        </div>
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <div class="text-right pt-2">
                {% if ((is_granted('ROLE_DISCORD_ADMIN') or climb.climber.id is same as(current_user().id) and climb.isReviewed == false) or (is_granted('ROLE_DISCORD_AUTHORIZER') and climb.isReviewed == false)) %}
                    <a href="{{ path('climb_update', { 'climbId': climb.id }) }}">
                        <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Edit</button>
                    </a>
                {% endif %}
                {% if (climb.climber.id is same as(current_user().id)) or (is_granted('ROLE_DISCORD_AUTHORIZER')) %}
                    <a href="{{ path('climb_delete', { 'climbId': climb.id }) }}">
                        <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
