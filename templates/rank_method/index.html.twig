{% extends 'base.html.twig' %}

{% block title %}Rank Methods{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <div class="flex justify-between">
            <h1 class="text-4xl font-bold mt-1">Rank Methods</h1>
            <!-- TODO: fix is granted -->
            {% if is_granted('rank_method_create') %}
                <a href="{{ path('rank_method_create') }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">New</button>
                </a>
            {% endif %}
        </div>
        <div class="mt-2">
            <table class="w-full border-collapse [&_td]:py-2">
                <thead>
                    <tr>
                        <th class="text-left">Name</th>
                        <th class="text-left">Categories</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rankMethod in rankMethods %}
                        <tr class="hover:bg-gray-900 border-t border-gray-700">
                            <td>
                                <a class="block" href="{{ path('rank_method_read', { 'rankMethodId': rankMethod.id }) }}">{{ rankMethod.name|escape }}</a>
                            </td>
                            <td>
                                <a href="{{ path('rank_method_read', { 'rankMethodId': rankMethod.id }) }}" class="block">
                                    {% set visible = 3 %}
                                    {% for category in rankMethod.categories|slice(0, visible) %}
                                        {{ category.name|escape }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                    {% if rankMethod.categories|length > visible %}
                                        +{{ rankMethod.categories|length - visible }} more
                                    {% elseif rankMethod.categories|length === 0 %}
                                        —
                                    {% endif %}
                                </a>
                            </td>
                            {% if is_granted('rank_method_update', rankMethod) or is_granted('rank_method_read', rankMethod) or is_granted('rank_method_delete', rankMethod) %}
                                <td class="text-right">
                                    <span class="text-left inline-flex align-middle bg-black rounded-sm border border-gray-700 border-solid text-white font-bold cursor-pointer">
                                        {% if is_granted('rank_method_update', rankMethod) %}
                                            <a href="{{ path('rank_method_update', { 'rankMethodId': rankMethod.id }) }}" class="hover:bg-gray-600 p-1">
                                                <i class="mdi mdi-pencil"></i>
                                            </a>
                                        {% endif %}
                                        <el-dropdown>
                                            <button class="hover:bg-gray-600 p-1">
                                                <span class="sr-only">Open additional options menu</span>
                                                <i class="mdi mdi-chevron-down"></i>
                                            </button>
                                            <el-menu anchor="bottom end" popover class="w-28 origin-top-right rounded-md bg-black text-white py-1 outline -outline-offset-1 outline-red-900 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
                                                {% if is_granted('rank_method_read', rankMethod) %}
                                                    <a href="{{ path('rank_method_read', { 'rankMethodId': rankMethod.id }) }}" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">
                                                        <i class="mdi mdi-eye"></i>
                                                        View
                                                    </a>
                                                {% endif %}
                                                {% if is_granted('rank_method_update', rankMethod) %}
                                                    <a href="{{ path('rank_method_update', { 'rankMethodId': rankMethod.id }) }}" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">
                                                        <i class="mdi mdi-pencil"></i>
                                                        Edit
                                                    </a>
                                                {% endif %}
                                                {% if is_granted('rank_method_delete', rankMethod) %}
                                                    <a href="{{ path('rank_method_delete', { 'rankMethodId': rankMethod.id }) }}" class="block px-4 py-2 text-sm text-gray-300 focus:bg-gray-900 focus:outline-hidden">
                                                        <i class="mdi mdi-trash-can"></i>
                                                        Delete
                                                    </a>
                                                {% endif %}
                                            </el-menu>
                                        </el-dropdown>
                                    </span>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% include 'partials/pagination.html.twig' %}
        </div>
    </div>
{% endblock %}
