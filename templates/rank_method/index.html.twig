{% extends 'base.html.twig' %}

{% block title %}Hello RankMethodController!{% endblock %}

{% block body %}
    <ul>
        {% for rankMethod in rankMethods %}
            <li>
                <a href="{{ path('rank_method_read', {'rankMethodId': rankMethod.id|escape }) }}">{{ rankMethod.name|escape }}</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
