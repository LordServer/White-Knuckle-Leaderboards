{% extends 'base.html.twig' %}

{% block title %}Hello RankMethodController!{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        <div class="text-xs text-red-900">
            <a href="{{ path('app_index') }}" class="hover:text-red-400 cursor-pointer">Home</a> /
            <a href="{{ path('rank_method_index') }}" class="hover:text-red-400 cursor-pointer">Rank Methods</a> /
            <a href="{{ path('rank_method_read', { 'rankMethodId': rankMethod.id }) }}" class="hover:text-red-400 cursor-pointer">{{ rankMethod.name|escape }}</a> /
            <a href="{{ path('rank_method_delete', { 'rankMethodId': rankMethod.id }) }}" class="hover:text-red-400 cursor-pointer">Delete Confirmation</a>
        </div>
        <div class="flex justify-between">
            <h1 class="text-4xl font-bold mt-1">Delete {{ rankMethod.name|escape }}?</h1>
        </div>
        <div class="flex gap-2">
            <div class="flex-1">
                <div class="w-full py-2 text-white text-xl font-medium">ID</div>
                <div>{{ rankMethod.bin|escape }}</div>
            </div>
            <div class="flex-3">
                <div class="w-full py-2 text-white text-xl font-medium">Name</div>
                {{ rankMethod.name|escape }}
            </div>
        </div>
        {{ form_start(form) }}
        <div class="text-right pt-2">
            <a href="{{ path('rank_method_read', { 'rankMethodId': rankMethod.id }) }}">
                <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Cancel</button>
            </a>
            <button type="submit" class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
        </div>
        <div class="hidden">
            {{ form_rest(form) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
