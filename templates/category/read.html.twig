{% extends 'base.html.twig' %}

{% block title %}{{ category.name|escape }}{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <h1 class="text-4xl font-bold mt-1">{{ category.name|escape }}</h1>
        <div class="mt-2">
            {{ category.rules|escape }}<br><br>
            {{ category.name|escape }} is ranked by <a href="{{ path('rank_method_read', {'rankMethodId': category.rankMethod.id}) }}">{{ category.rankMethod.name|escape }}</a>.<br>
            It has {{ category.subcategory|length }} subcategories; {% for subcategory in category.subcategory %}<a href="{{ path('subcategory_read', {'subcategoryId': subcategory.id}) }}">{{ subcategory.name|escape }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
        </div>
            <div class="text-right pt-2">
                {% if is_granted('category_update', category) %}
                    <a href="{{ path('category_update', { 'categoryId': category.id }) }}">
                        <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Edit</button>
                    </a>
                {% endif %}
                {% if is_granted('category_delete', category) %}
                    <a href="{{ path('category_delete', { 'categoryId': category.id }) }}">
                        <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
                    </a>
                {% endif %}
            </div>
    </div>
{% endblock %}
