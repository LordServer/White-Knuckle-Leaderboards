{% extends 'base.html.twig' %}

{% block title %}Update {{ category.name|escape }}{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <div class="flex justify-between items-center">
            <h1 class="text-4xl font-bold mt-1">Editing {{ category.name|escape }}</h1>
            <div class="text-right">
                <div class="group relative inline-block">
                    <div class="text-xs text-gray-400">
                        Created {{ category.createdAt|date('Y-m-d H:i:s')|ago|escape }}
                    </div>
                    <div class="hidden group-hover:block absolute z-10 w-fit p-2 mt-2 text-sm bg-gray-900 text-white rounded-lg">
                        {{ category.createdAt|local_datetime|escape }}
                    </div>
                </div>
                <br>
                <div class="group relative inline-block">
                    <div class="text-sm text-gray-300">
                        Updated {{ category.updatedAt|date('Y-m-d H:i:s')|ago|escape }}
                    </div>
                    <div class="hidden group-hover:block absolute z-10 w-fit p-2 mt-2 text-sm bg-gray-900 text-white rounded-lg">
                        {{ category.updatedAt|local_datetime|escape }}
                    </div>
                </div>
            </div>
        </div>
        <div>
            {{ form_start(form) }}
            <div class="flex gap-2">
                <div class="flex-7">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.name) }}</div>
                    {{ form_widget(form.name, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium text-center">Archived?</div>
                    {{ form_widget(form.isArchived, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
            </div>
            <div class="flex gap-2">
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.subcategory) }}</div>
                    {{ form_widget(form.subcategory, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
                <div class="flex-1">
                    <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.rankMethod) }}</div>
                    {{ form_widget(form.rankMethod, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
                </div>
            </div>
            <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.rules) }}</div>
            {{ form_widget(form.rules, {'attr': {'class': 'w-full h-50 py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
            <div class="text-right pt-2">
                <a href="{{ path('category_read', { 'categoryId': category.id }) }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Cancel</button>
                </a>
                <button type="submit" class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Update</button>
                <a href="{{ path('category_delete', { 'categoryId': category.id }) }}">
                    <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
                </a>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
