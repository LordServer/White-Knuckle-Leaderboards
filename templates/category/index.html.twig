{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <div class="flex justify-between">
            <h1 class="text-4xl font-bold mt-1">Categories</h1>
            {% if is_granted('ROLE_DISCORD_ADMIN') %}
                <a href="{{ path('category_create') }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">New</button>
                </a>
            {% endif %}
        </div>
        <div class="mt-2">
            <table class="w-full border-collapse">
                <thead>
                    <tr>
                        <th class="text-left">Name</th>
                        <th class="text-left">Subcategories</th>
                        <th class="text-left">Rank Method</th>
                        <th class="text-left">Archived?</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr class="hover:bg-gray-600">
                            <td>
                                <a href="{{ path('category_read', {'categoryId': category.id}) }}" class="block">{{ category.name }}</a>
                            </td>
                            <td>
                                <a href="{{ path('category_read', {'categoryId': category.id}) }}" class="block">
                                    {% for subcategory in category.subcategory %}
                                        {{ subcategory.name|escape }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </a>
                            </td>
                            <td>
                                <a href="{{ path('category_read', {'categoryId': category.id}) }}" class="block">{{ category.rankMethod.name|escape }}</a>
                            </td>
                            <td>
                                <a href="{{ path('category_read', {'categoryId': category.id}) }}" class="block">{% if category.isArchived is true %}Yes{% endif %}</a>
                            </td>
                            {% if is_granted('ROLE_DISCORD_ADMIN') %}
                                <td>
                                    <a href="{{ path('category_update', { 'categoryId': category.id }) }}">
                                        <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-1 cursor-pointer hover:bg-gray-600">Edit</button>
                                    </a>
                                    <a href="{{ path('category_delete', { 'categoryId': category.id }) }}">
                                        <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-1 cursor-pointer hover:bg-red-400">Delete</button>
                                    </a>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
