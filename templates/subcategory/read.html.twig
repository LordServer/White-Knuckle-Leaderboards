{% extends 'base.html.twig' %}

{% block title %}{{ subcategory.name|escape }}{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <h1 class="text-4xl font-bold mt-1">{{ subcategory.name|escape }}</h1>
        <div class="mt-2">
            {{ subcategory.name|escape }} is used by {{ subcategory.categories|length }} categories; {% for category in subcategory.categories %}<a href="{{ path('category_read', {'categoryId': category.id}) }}">{{ category.name|escape }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
        </div>
        {% if is_granted('ROLE_DISCORD_ADMIN') %}
            <div class="text-right pt-2">
                <a href="{{ path('subcategory_update', { 'subcategoryId': subcategory.id }) }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Edit</button>
                </a>
                <a href="{{ path('subcategory_delete', { 'subcategoryId': subcategory.id }) }}">
                    <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}
