{% extends 'base.html.twig' %}

{% block title %}Update {{ subcategory.name|escape }}{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <div class="flex justify-between">
            <h1 class="text-4xl font-bold mt-1">Editing {{ subcategory.name|escape }}</h1>
        </div>
        <div>
            {{ form_start(form) }}
            <div class="w-full py-2 text-white text-xl font-medium">{{ form_label(form.name) }}</div>
            {{ form_widget(form.name, {'attr': {'class': 'w-full py-2 bg-neutral-950 hover:bg-neutral-600 focus:bg-neutral-600 border-4 border-solid border-neutral-600 focus:border-red-950 rounded text-white text-xl font-medium outline-none'}}) }}
            <div class="text-right pt-2">
                <a href="{{ path('subcategory_read', { 'subcategoryId': subcategory.id }) }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Cancel</button>
                </a>
                <button type="submit" class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Update</button>
                <a href="{{ path('subcategory_delete', { 'subcategoryId': subcategory.id }) }}">
                    <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
                </a>
            </div>
            {{ form_rest(form) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
