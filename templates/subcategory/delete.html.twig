{% extends 'base.html.twig' %}

{% block title %}Delete {{ subcategory.name|escape }}?{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <div class="flex justify-between">
            <h1 class="text-4xl font-bold mt-1">Delete {{ subcategory.name|escape }}?</h1>
        </div>
        <div class="w-full py-2 text-white text-xl font-medium">Name</div>
        {{ subcategory.name|escape }}
        {{ form_start(form) }}
        <div class="text-right pt-2">
            <a href="{{ path('subcategory_read', { 'subcategoryId': subcategory.id }) }}">
                <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">Cancel</button>
            </a>
            <button type="submit" class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-red-400">Delete</button>
        </div>
        <div class="hidden">
            {{ form_rest(form) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
