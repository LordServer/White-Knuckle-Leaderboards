{% extends 'base.html.twig' %}

{% block title %}Hello SubcategoryController!{% endblock %}

{% block body %}
    <div class="pt-2 pr-4 pb-2 pl-4">
        {% include 'partials/breadcrumbs.html.twig' %}
        <div class="flex justify-between">
            <h1 class="text-4xl font-bold mt-1">Subcategories</h1>
            {% if is_granted('ROLE_DISCORD_ADMIN') %}
                <a href="{{ path('subcategory_create') }}">
                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-2 cursor-pointer hover:bg-gray-600">New</button>
                </a>
            {% endif %}
        </div>
        <div class="mt-2">
            <table class="w-full border-collapse">
                <thead>
                <tr>
                    <th class="text-left">Name</th>
                </tr>
                </thead>
                <tbody>
                {% for subcategory in subcategories %}
                    <tr class="hover:bg-gray-600">
                        <td>
                            <a href="{{ path('subcategory_read', {'subcategoryId': subcategory.id}) }}" class="block">{{ subcategory.name|escape }}</a>
                        </td>
                        {% if is_granted('ROLE_DISCORD_ADMIN') %}
                            <td class="text-right">
                                <a href="{{ path('subcategory_update', { 'subcategoryId': subcategory.id }) }}">
                                    <button class="bg-black rounded-sm border border-gray-600 border-solid text-white font-bold p-1 cursor-pointer hover:bg-gray-600">Edit</button>
                                </a>
                                <a href="{{ path('subcategory_delete', { 'subcategoryId': subcategory.id }) }}">
                                    <button class="bg-red-900 rounded-sm border border-gray-600 border-solid text-white font-bold p-1 cursor-pointer hover:bg-red-400">Delete</button>
                                </a>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
